# 服务端口（对应 application.yml server.port；Docker 容器内固定 8080）
SERVER_PORT=8089

# 跨域允许的来源，逗号分隔；生产环境必须显式配置（不配置则仅允许本地前端）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# 接口鉴权总开关：true 时非 GET 的 /api/** 必须携带 Bearer Token（默认 false）
REQUIRE_AUTH=false

# 数据库密码（通过 SPRING_DATASOURCE_PASSWORD 注入；docker-compose 内默认 root）
DB_PASSWORD=123456
